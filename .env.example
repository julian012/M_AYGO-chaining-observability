# Plantilla SIN secretos reales. `make setup` genera un .env con valores aleatorios.
INTERNAL_TOKEN=<aleatorio-48-hex>
CORRELATOR_TOKEN=<aleatorio-48-hex>
API_KEYS=mobile:<clave>,web:<clave>,partner:<clave>
GATEWAY_BIND=127.0.0.1     # en AWS: 0.0.0.0 (el Security Group limita quién entra)
FAULT_RATE=0.0             # 0..1, fallos simulados en el core legacy
# Opcionales: LATENCY_MIN_MS, LATENCY_MAX_MS, RATE_PER_SEC, RATE_BURST, MAX_EVENTS
